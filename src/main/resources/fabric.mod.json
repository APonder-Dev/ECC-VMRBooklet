{
	"schemaVersion": 1,
	"id": "vmrbooklet",
	"version": "${version}",
	"name": "VMR Booklet",
	"description": "A client-side collection tracker for every vanilla item: a searchable, filterable booklet with recipes, how-to-get notes, crafting-chain trees, goal lists, streaks, and friend comparison. Progress comes from the server's /booklet GUI, /sell, a Google Sheet, or manual edits. Works on any server; nothing installed server-side.",
	"authors": [
		"Anthony"
	],
	"contact": {
		"homepage": "https://github.com/APonder-Dev/ECC-VMRBooklet",
		"sources": "https://github.com/APonder-Dev/ECC-VMRBooklet",
		"issues": "https://github.com/APonder-Dev/ECC-VMRBooklet/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/vmrbooklet/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"dev.aponder.vmrbooklet.VMRBooklet"
		],
		"client": [
			"dev.aponder.vmrbooklet.client.VMRBookletClient"
		],
		"modmenu": [
			"dev.aponder.vmrbooklet.client.VMRBookletModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "vmrbooklet.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.163.0"
	},
	"suggests": {
		"modmenu": "*"
	}
}
